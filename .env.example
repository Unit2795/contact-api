# Copy to .env (gitignored) for pnpm e2e, or set the same variables in the environment.
# Values are in SSM Parameter Store, in the region you deployed to (us-east-1 unless you set aws-region):
#   CONTACT_URL      = "https://" + value of /contact-api/origin-domain
#   CONTACT_SITE_KEY = value of /contact-api/sites/<site>/origin-key (SecureString; "Show decrypted value")
CONTACT_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.lambda-url.<region>.on.aws
CONTACT_SITE_KEY=

# Optional: form to test. Must belong to the key's site. Defaults to the first form in forms.json.
# CONTACT_FORM=portfolio-contact
