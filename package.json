{
	"name": "contact-api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "esbuild src/handler.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs",
		"e2e": "node --env-file-if-exists=.env scripts/e2e.ts"
	},
	"packageManager": "pnpm@11.18.0",
	"devDependencies": {
		"@types/aws-lambda": "^8.10.163",
		"@types/node": "^26.6.2",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.1138.0",
		"@aws-sdk/client-sesv2": "^3.1137.0"
	}
}
